{
  "manifest_version": 3,
  "name": "Phishing Guardian",
  "version": "1.0",
  "description": "Detector de phishing para Gmail",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Phishing Guardian",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
    "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ]
}